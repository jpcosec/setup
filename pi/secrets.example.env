# ~/.pi/agent/secrets.env  (chmod 600) — Pi provider keys only.
# Single source for auth.json `!$HOME/.pi/agent/bin/get-secret VAR` entries.
# OAuth providers (anthropic subscription, openai-codex, google-*) stay in
# ~/.pi/agent/auth.json via /login; nothing to add here for them.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
