# Provider credentials are resolved by variable name from models.json,
# or stored in ~/.pi/agent/auth.json (api_key / oauth entries).
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Subscription providers use OAuth via `/login` (no key here):
#   anthropic           -> Claude Pro/Max
#   openai-codex        -> ChatGPT Plus/Pro
#   google-antigravity  -> Google account (free tier)
#   google-gemini-cli   -> Google account (needs Code Assist license)

# Optional endpoint / client-version overrides for the Pi fork.
# Google gates newer Antigravity models by client version (>= 2.9.1).
PI_GOOGLE_GEMINI_ENDPOINT=
PI_ANTIGRAVITY_ENDPOINT=
PI_AI_ANTIGRAVITY_VERSION=
# Anthropic OAuth rejects new models on old claude-cli versions.
PI_AI_CLAUDE_CODE_VERSION=

# Optional provider and runtime settings.
PI_CODING_AGENT_DIR=
PI_OFFLINE=0
PI_TELEMETRY=0
