#!/usr/bin/env bash
# Resolve a Pi provider secret by variable name from ~/.pi/agent/secrets.env.
# Referenced from ~/.pi/agent/auth.json as: "!$HOME/.pi/agent/bin/get-secret VAR"
# Only Pi provider keys belong in this file; nothing else.
set -euo pipefail
name="${1:?usage: get-secret VAR_NAME}"
file="${PI_SECRETS_FILE:-$HOME/.pi/agent/secrets.env}"
[[ -r "$file" ]] || { printf 'get-secret: unreadable %s\n' "$file" >&2; exit 1; }
val="$(grep -m1 "^${name}=" "$file" | cut -d= -f2- || true)"
val="${val%\"}"; val="${val#\"}"; val="${val%\'}"; val="${val#\'}"
[[ -n "$val" ]] || { printf 'get-secret: %s not found in %s\n' "$name" "$file" >&2; exit 1; }
printf '%s' "$val"
